[include]
  # https://raw.githubusercontent.com/dandavison/delta/refs/heads/main/themes.gitconfig
  path = ~/.local/share/delta/themes.gitconfig
[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    # https://raw.githubusercontent.com/dandavison/delta/refs/heads/main/themes.gitconfig
    #features = colibri
    #features = collared-trogon
    #features = coracias-caudatus
    #features = hoopoe
    #features = tangara-chilensis
    #features = villsau
    #features = woolly-mammoth
    #features = calochortus-lyallii
    #features = mantis-shrimp
    #features = mantis-shrimp-lite
    #features = zebra-dark
    #features = zebra-light
    #features = chamelon
    #features = gruvmax-fang # close
    #features = discord
    #features = mellow-barbet
    features = patina
    side-by-side = false
    #features = arctic-fox # close
    #features = corvus
    #features = platypus
    #features = weeping-willow
    #features = mirthful-willow

    # delta detects terminal colors automatically; set one of these to disable auto-detection
    # dark = true
    # light = true

[delta "patina"]
    dark = true
    true-color = always
    syntax-theme = Nord
    file-style = bold "#A3C8EE"
    hunk-header-style = file line-number syntax
    zero-style = syntax
    minus-style = syntax "#3A2F33"
    minus-non-emph-style = syntax "#3A2F33"
    minus-emph-style = syntax "#583840"
    minus-empty-line-marker-style = normal "#3A2F33"
    plus-style = syntax "#2D3932"
    plus-non-emph-style = syntax "#2D3932"
    plus-emph-style = syntax "#3C5142"
    plus-empty-line-marker-style = normal "#2D3932"

[merge]
    conflictstyle = zdiff3
